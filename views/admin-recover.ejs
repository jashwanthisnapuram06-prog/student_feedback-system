<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Recover Admin Password</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="container section-card form-card">
    <h1>Recover Admin Password</h1>
    <% if (error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>
    <% if (message) { %>
      <div class="alert info">
        <p><%= message %></p>
        <% if (otp) { %>
          <div class="mock-otp-box" style="margin-top: 15px; padding: 12px; background: rgba(0, 0, 0, 0.05); border-radius: 8px; text-align: center;">
            Mock OTP Code: <strong style="font-size: 1.4em; letter-spacing: 2px; color: #2f7bff;"><%= otp %></strong>
          </div>
          <div style="margin-top: 15px; text-align: center;">
            <a class="button" href="/admin/reset?email=<%= encodeURIComponent(email) %>" style="display: inline-block; text-decoration: none;">Proceed to Reset Password</a>
          </div>
        <% } %>
      </div>
    <% } %>
    
    <% if (!otp) { %>
      <form action="/admin/recover" method="POST">
        <label for="email">Registered Gmail</label>
        <input id="email" name="email" type="email" required placeholder="name@gmail.com" />
        <button class="button" type="submit">Send OTP</button>
        <div class="link-row">
          <a href="/admin/login">Back to Login</a>
        </div>
      </form>
    <% } else { %>
      <div class="link-row" style="margin-top: 20px; justify-content: center;">
        <a href="/admin/login">Back to Login</a>
      </div>
    <% } %>
  </div>
</body>
</html>
